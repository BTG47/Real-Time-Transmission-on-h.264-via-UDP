      <value>{python} -u {filename}</value>
    </param>
    <param>
      <key>hier_block_src_path</key>
      <value></value>
    </param>
    <param>
      <key>comment</key>
      <value>Reference TX for TRANSPORT="radio". Start after RX flowgraph has bound 5556 and after python radio/reciever_radio.py is running.</value>
    </param>
