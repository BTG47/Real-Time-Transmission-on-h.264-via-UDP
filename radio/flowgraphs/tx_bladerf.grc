  <block>
    <key>options</key>
    <param>
      <key>id</key>
      <value>tx_bladerf</value>
    </param>
    <param>
      <key>title</key>
      <value>BladeRF TX over ZMQ PDU (H.264 via GNU Radio)</value>
    </param>
    <param>
      <key>author</key>
      <value></value>
    </param>
    <param>
      <key>description</key>
      <value>Reference TX flowgraph: receives an H.264 PMT PDU (pmt::serialize_str(cons(dict, u8vector))) over ZMQ PULL on tcp://127.0.0.1:5555, wraps it in burst format (access code + 16-bit length header), applies GMSK (8 sps, bt 0.3) and transmits with a BladeRF at 2.45 GHz / 20 Msps.</value>
    </param>
    <param>
      <key>window_size</key>
      <value></value>
    </param>
    <param>
      <key>generate_options</key>
      <value>no_gui</value>
    </param>
    <param>
      <key>output_language</key>
      <value>python</value>
    </param>
    <param>
      <key>max_nouts</key>
      <value>0</value>
    </param>
    <param>
      <key>realtime</key>
      <value>false</value>
    </param>
    <param>
      <key>run_command</key>
      <value>{python} -u {filename}</value>
    </param>
    <param>
      <key>hier_block_src_path</key>
      <value></value>
    </param>
    <param>
      <key>comment</key>
      <value>Reference TX for TRANSPORT="radio". Start after RX flowgraph has bound 5556 and after python radio/reciever_radio.py is running.</value>
    </param>
  </block>
