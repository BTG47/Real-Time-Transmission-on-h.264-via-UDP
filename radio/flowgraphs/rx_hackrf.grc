      <value>0</value>
    </param>
    <param>
      <key>realtime</key>
      <value>false</value>
    </param>
    <param>
      <key>run_command</key>
      <value>{python} -u {filename}</value>
    </param>
    <param>
      <key>hier_block_src_path</key>
      <value></value>
    </param>
    <param>
      <key>comment</key>
      <value>Reference RX for TRANSPORT="radio". Must bind 5556 before python radio/reciever_radio.py connects to it.</value>
    </param>
  </block>
