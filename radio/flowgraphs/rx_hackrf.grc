    <param>
      <key>title</key>
      <value>HackRF RX over ZMQ PDU (H.264 via GNU Radio)</value>
    </param>
    <param>
      <key>author</key>
      <value></value>
    </param>
    <param>
      <key>description</key>
      <value>Reference RX flowgraph: receives GMSK at 2.45 GHz / 20 Msps with a HackRF via gr-osmosdr, decodes the tagged stream and forwards the PMT PDU (pmt::serialize_str(cons(dict, u8vector))) over ZMQ PUSH bound to tcp://127.0.0.1:5556.</value>
    </param>
    <param>
      <key>window_size</key>
      <value></value>
    </param>
    <param>
